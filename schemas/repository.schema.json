{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrishotza/Repo-Orbit/blob/main/schemas/repository.schema.json",
  "title": "RepoOrbit project record v0.1",
  "type": "object",
  "required": [
    "id",
    "full_name",
    "url",
    "topics",
    "discovered_via",
    "verification",
    "last_verified_at",
    "metadata_fetched_at",
    "github_id",
    "stars",
    "archived",
    "language",
    "updated_at",
    "license_spdx",
    "cost",
    "functional_test"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$"
    },
    "full_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "discovered_via": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "enum": [
        "repository_exists"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date"
    },
    "metadata_fetched_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "github_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "github_full_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "stars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "archived": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "license_spdx": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost": {
      "enum": [
        "unknown",
        "free_verified",
        "free_with_limits",
        "paid_required",
        "mixed"
      ]
    },
    "functional_test": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "inconclusive"
      ]
    }
  },
  "additionalProperties": false,
  "description": "Null is unknown. GitHub repository existence is distinct from functional or cost verification."
}
